# Postgres: the product catalogue
POSTGRES_DB_URI=postgresql://postgres:postgres@localhost:5432/ecommerce

# Mongo: reserved for an upcoming bounded context. Connected at boot, so this
# must be reachable even though no code queries it yet.
MONGO_DB_URI=mongodb://localhost:27017/ecommerce
MONGO_DB_NAME=ecommerce

# HTTP port
PORT=3000
