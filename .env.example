# Postgres: the product catalogue
POSTGRES_DB_URI=postgresql://postgres:postgres@localhost:5432/ecommerce

# Mongo: reserved for an upcoming bounded context. Connected at boot, so this
# must be reachable even though no code queries it yet.
MONGO_DB_URI=mongodb://localhost:27017/ecommerce
MONGO_DB_NAME=ecommerce

# HTTP port
PORT=3000

# Signs and verifies access tokens (HS256). No default: generate one with
# `openssl rand -base64 48` and never commit the real value.
JWT_SECRET=

# How long an access token is accepted after issue.
ACCESS_TOKEN_TTL_SECONDS=900

# How long a refresh token's rotation chain stays valid.
REFRESH_TOKEN_TTL_DAYS=30

# How long a password reset link stays valid.
PASSWORD_RESET_TTL_MINUTES=60

# How long an email verification link stays valid.
EMAIL_VERIFICATION_TTL_HOURS=24

# How long a session survives without a request. Also the session cookie's
# Max-Age, so the browser forgets the cookie when the server would.
SESSION_IDLE_TTL_DAYS=30

# The cap no amount of activity extends past. Must be at least the idle TTL.
SESSION_ABSOLUTE_TTL_DAYS=365

# Mailpit: local SMTP for verification and password-reset emails.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@example.com

# Origin the frontend is served from, used to build links sent in emails.
WEB_BASE_URL=http://localhost:5173
