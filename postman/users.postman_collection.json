        },
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Replaces the whole user. `email` is deliberately absent from the payload: it is immutable after registration, and sending it answers 400 from `forbidNonWhitelisted` rather than being silently ignored (ADR 0014)."
      },
      "response": []
    },
