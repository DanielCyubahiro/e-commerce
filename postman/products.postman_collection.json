      "id": "6e6ace52-e668-4c5c-a738-6859a08af6b9",
      "description": "The interesting half of this API. Each request provokes one documented failure so you can see which layer answered.\n\nRun `Create product` first: two of these depend on a product existing."
    },
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "",
              "pm.test('Location header points at the new product', () => {",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/products/' + body.id);",
              "});",
              "",
              "pm.collectionVariables.set('productId', body.id);"
            ]
          }
        }
      ],
      "id": "c0c5e472-1e9a-4e01-a12e-0ff6a55ea801",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Espresso Machine\",\n  \"description\": \"Makes espresso.\",\n  \"price\": 249.99,\n  \"sku\": \"ESP-001\",\n  \"stock\": 12,\n  \"currency\": \"EUR\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        },
        "description": "Creates a product and captures its id. Protected: needs the `{{accessToken}}` Login stores in the shared environment."
      },
      "response": []
    },
    {
      "name": "List products",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('carries the pagination envelope', () => {",
              "  pm.expect(pm.response.json()).to.include.keys('items', 'total', 'limit', 'offset');",
              "});"
            ]
          }
        }
      ],
      "id": "bc646514-bab0-43b0-8428-1d9060ad0158",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?limit=20&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20",
              "description": "1 to 100. Defaults to 20."
            },
            {
              "key": "offset",
              "value": "0",
              "description": "Zero or greater. Defaults to 0."
            },
            {
              "key": "minPrice",
              "value": "100",
              "description": "Decimal. Requires currency.",
              "disabled": true
            },
            {
              "key": "maxPrice",
              "value": "300",
              "description": "Decimal. Requires currency.",
              "disabled": true
            },
            {
              "key": "currency",
              "value": "EUR",
              "description": "Required as soon as either price bound is set.",
              "disabled": true
            }
          ]
        },
        "description": "Lists products, newest first. `@Public()`: browsing the catalogue needs no account."
      },
      "response": []
    },
    {
      "name": "Get product by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('price is a decimal, never minor units', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.price).to.be.a('number');",
              "  pm.expect(body).to.not.have.property('priceMinorUnits');",
              "});"
            ]
          }
        }
      ],
