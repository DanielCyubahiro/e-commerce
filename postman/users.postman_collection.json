      "id": "eb09682e-b6a5-42aa-b76b-369f8444fb3a",
      "description": "The interesting half of this API. Each request provokes one documented failure so you can see which layer answered.\n\nRun `Create user` first: two of these depend on a user existing."
    },
    {
      "name": "Create user",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "",
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "",
              "pm.test('Location header points at the new user', () => {",
              "  pm.expect(pm.response.headers.get('Location')).to.eql('/users/' + body.id);",
              "});",
              "",
              "pm.collectionVariables.set('userId', body.id);"
            ]
          }
        }
      ],
      "id": "b167ccd8-6a20-4c89-977b-15d7263e3cbb",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Mensah\",\n  \"email\": \"{{userEmail}}\",\n  \"role\": \"customer\",\n  \"phone\": \"+32 489 12 34 56\",\n  \"password\": \"{{userPassword}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "description": "Creates a user and captures its id. Registration is the one public endpoint on this controller, so the request overrides auth to No Auth.\n\n`password` is required and must be 12 to 128 characters; `Password.create` owns the floor and answers 422 below it. The body reads `{{userEmail}}` and `{{userPassword}}` from the shared environment, the same values Login in the auth-context collection verifies against, so the two collections cannot drift apart. Registration also sends the verification email that collection consumes."
      },
      "response": []
    },
    {
      "name": "List users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('carries the pagination envelope', () => {",
              "  pm.expect(pm.response.json()).to.include.keys('items', 'total', 'limit', 'offset');",
              "});"
            ]
          }
        }
      ],
      "id": "5e2a9ea1-8d2d-4a98-a78f-4cc2377b18c7",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users?limit=20&offset=0",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "limit",
              "value": "20",
              "description": "1 to 100. Defaults to 20."
            },
            {
              "key": "offset",
              "value": "0",
              "description": "Zero or greater. Defaults to 0."
            },
            {
              "key": "role",
              "value": "customer",
              "description": "customer or seller. Anything else is a 422, not an empty page.",
              "disabled": true
            }
          ]
        },
        "description": "Lists users."
      },
      "response": []
    },
    {
      "name": "Get user by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "",
              "pm.test('phone is a key even when the user has none', () => {",
              "  pm.expect(pm.response.json()).to.have.property('phone');",
              "});",
              "",
              "pm.test('email came back lowercased', () => {",
              "  const email = pm.response.json().email;",
              "  pm.expect(email).to.eql(email.toLowerCase());",
              "});"
            ]
          }
        }
      ],
      "id": "bce48de0-8b0b-4608-a55c-ce07a2670d81",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}"
          ]
        },
        "description": "Reads back the user created above."
      },
      "response": []
    },
